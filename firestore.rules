// firestore.rules
// Deploy con: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'gabrieljacielcruz@gmail.com';
    }

    function isStudent(studentId) {
      // El email del alumno sigue el patrón {id}@schoolpay.local
      return request.auth != null
        && request.auth.token.email == studentId.lower() + '@schoolpay.local';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function kermesAccessPath() {
      return /databases/$(database)/documents/kermesAccess/$(request.auth.uid);
    }

    function isKermesTerminal() {
      return request.auth != null
        && exists(kermesAccessPath())
        && get(kermesAccessPath()).data.active == true;
    }

    function isKermesVendor() {
      return isKermesTerminal()
        && get(kermesAccessPath()).data.role == 'vendor';
    }

    function isKermesBank() {
      return isKermesTerminal()
        && get(kermesAccessPath()).data.role == 'bank';
    }

    function kermesVendorId() {
      return get(kermesAccessPath()).data.vendorId;
    }

    // ── Students ─────────────────────────────────────────────────────────────
    match /students/{studentId} {
      // El docente puede leer y escribir todo
      allow read, write: if isTeacher();
      // El alumno solo puede leer su propio documento
      allow read: if isStudent(studentId);
    }

    // ── Transactions ─────────────────────────────────────────────────────────
    match /transactions/{txId} {
      // Solo el docente escribe transacciones
      allow read, write: if isTeacher();
      // El alumno lee sus propias transacciones
      allow read: if isAuthenticated()
        && resource.data.studentId == request.auth.token.email.split('@')[0].upper();
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Docente: acceso total
      allow read, write: if isTeacher();
      // Alumno: crear y leer sus propias órdenes (no puede modificar status)
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.token.email.split('@')[0].upper()
        && request.resource.data.status == 'pending';
      allow read: if isAuthenticated()
        && resource.data.studentId == request.auth.token.email.split('@')[0].upper();
    }

    // ── Store Items ───────────────────────────────────────────────────────────
    match /storeItems/{itemId} {
      // Docente: acceso total
      allow read, write: if isTeacher();
      // Alumno: solo lectura (ver la tienda)
      allow read: if isAuthenticated();
    }

    // ── Quick Actions ─────────────────────────────────────────────────────────
    match /quickActions/{actionId} {
      // Solo el docente gestiona las acciones
      allow read, write: if isTeacher();
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read, write: if isTeacher();
      allow read: if isAuthenticated();
    }

    // ── Kermes ───────────────────────────────────────────────────────────────
    match /kermesAccess/{accessId} {
      allow get: if isTeacher()
        || (request.auth != null && request.auth.uid == accessId);
      allow list, create, update, delete: if isTeacher();
    }

    match /kermesCards/{cardId} {
      allow get: if true;
      allow list: if isTeacher() || isKermesTerminal();
      allow create, delete: if isTeacher();
      allow update: if isTeacher()
        || (
          isKermesTerminal()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
          && (
            (isKermesBank() && request.resource.data.balance >= resource.data.balance)
            || (isKermesVendor() && request.resource.data.balance <= resource.data.balance)
          )
        );
    }

    match /kermesVendors/{vendorId} {
      allow read: if isTeacher() || isKermesTerminal();
      allow write: if isTeacher();
    }

    match /kermesProducts/{productId} {
      allow read: if isTeacher() || isKermesTerminal();
      allow write: if isTeacher();
    }

    match /kermesTransactions/{txId} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        || (
          isKermesBank()
          && request.resource.data.type == 'recharge'
          && request.resource.data.amount > 0
        )
        || (
          isKermesVendor()
          && request.resource.data.type == 'purchase'
          && request.resource.data.amount < 0
          && request.resource.data.vendorId == kermesVendorId()
        );
      allow update, delete: if isTeacher();
    }
  }
}
